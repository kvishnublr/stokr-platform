# Stokr LITE - Dockerfile
# Multi-stage build for smaller image

FROM maven:3.9-eclipse-temurin-21-alpine AS builder

WORKDIR /app

# Copy pom files
COPY pom.xml .
COPY stokr-core/pom.xml ./stokr-core/
COPY stokr-trading/pom.xml ./stokr-trading/
COPY stokr-common/pom.xml ./stokr-common/

# Download dependencies
RUN mvn dependency:go-offline -B

# Copy source code
COPY stokr-core/src ./stokr-core/src
COPY stokr-trading/src ./stokr-trading/src
COPY stokr-common/src ./stokr-common/src

# Build the application
RUN mvn package -DskipTests -B

# Runtime stage
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Add non-root user
RUN addgroup -g 1001 -S stokr && adduser -u 1001 -S stokr -G stokr

# Copy the built jar
COPY --from=builder /app/stokr-core/target/*.jar ./stokr-core.jar
COPY --from=builder /app/stokr-trading/target/*.jar ./stokr-trading.jar

# Copy application properties
COPY stokr-core/src/main/resources/application.properties ./

# Create config directory
RUN mkdir -p /app/config

# Change ownership
RUN chown -R stokr:stokr /app

USER stokr

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

# Run
ENTRYPOINT ["java", "-jar", "-Xms256m", "-Xmx512m", "/app/stokr-core.jar"]
