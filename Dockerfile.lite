# Stokr LITE - Dockerfile
# Multi-stage build for smaller image

FROM maven:3.9-eclipse-temurin-21-alpine AS builder

WORKDIR /app

# Copy only LITE module pom files
COPY pom.xml ./pom.xml
COPY stokr-core/pom.xml ./stokr-core/pom.xml
COPY stokr-trading/pom.xml ./stokr-trading/pom.xml
COPY stokr-common/pom.xml ./stokr-common/pom.xml

# Copy source code for LITE modules
COPY stokr-core/src ./stokr-core/src
COPY stokr-trading/src ./stokr-trading/src
COPY stokr-common/src ./stokr-common/src

# Build only the LITE modules with Spring Boot repackaging (skip other modules)
RUN mvn package -pl stokr-core,stokr-trading -am spring-boot:repackage -DskipTests -B

# Runtime stage
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Add non-root user
RUN addgroup -g 1001 -S stokr && adduser -u 1001 -S stokr -G stokr

# Copy the built Spring Boot JAR
COPY --from=builder /app/stokr-core/target/stokr-core-*.jar ./app.jar

# Copy application properties
COPY stokr-core/src/main/resources/application.properties /app/config/

# Create config directory
RUN mkdir -p /app/config

# Change ownership
RUN chown -R stokr:stokr /app

USER stokr

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

# Run
ENTRYPOINT ["java", "-jar", "-Xms256m", "-Xmx512m", "/app/app.jar"]
