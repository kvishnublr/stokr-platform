# Copy to .env at repo root (gitignored). Spring Boot imports ../.env and ./.env so IntelliJ picks up DB_* without a run-config env block.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stokr_platform
DB_USER=postgres
DB_PASSWORD=root
# If you only use `docker compose up postgres` (no local Postgres), use instead:
# DB_USER=stokr
# DB_PASSWORD=stokr

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# When RabbitMQ is not running (IntelliJ + Postgres only), avoids listener retries and Rabbit health noise:
# STOKR_RABBIT_HEALTH_ENABLED=false
# STOKR_RABBIT_LISTENERS_ENABLED=false
# When RabbitMQ is running (e.g. docker compose), enable health + listeners:
 STOKR_RABBIT_HEALTH_ENABLED=true
 STOKR_RABBIT_LISTENERS_ENABLED=true

# If UI is not on 5173, set so the logged email-verification link matches your dev server:
# STOKR_EMAIL_VERIFY_BASE_URL=http://localhost:3000

# Optional: real SMTP for verification emails (maps to spring.mail.*). Leave host unset to use log fallback only.
# Mailtrap (example): SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io SPRING_MAIL_PORT=587 SPRING_MAIL_USERNAME=… SPRING_MAIL_PASSWORD=…
# Gmail: SPRING_MAIL_HOST=smtp.gmail.com SPRING_MAIL_PORT=587 SPRING_MAIL_USERNAME=you@gmail.com SPRING_MAIL_PASSWORD=app-password
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true

# Optional: throttle resend-verification (seconds between sends). 0 = off. Example production: 60
# STOKR_AUTH_VERIFY_RESEND_COOLDOWN=60

JWT_SECRET=replace-with-long-random-secret-min-256-bits-worth-for-production

# Strategy subscription default symbol when user toggles from catalog UI
STOKR_STRATEGY_SUBSCRIPTION_SYMBOL=NIFTY_FUT
