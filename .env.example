# =============================================================================
# Single source of truth: edit THIS file (repo-root .env), then restart API.
# Spring Boot loads it via spring.config.import (see stokr-bootstrap/application.yml).
# Docker Compose interpolates the same variables into stokr-api from this file.
# Do not duplicate origins/URLs in application.yml except defaults — use variables below.
#
# TLS at the edge: set STOKR_* URLs to the public https:// values users see. The API already uses
# server.forward-headers-strategy=framework and Tomcat RemoteIpValve (see application.yml) so redirects
# and request URLs respect X-Forwarded-Proto / Host from nginx or a load balancer.
# =============================================================================

# Copy to .env at repo root (gitignored). Spring Boot imports ../.env and ./.env so IntelliJ picks up DB_* without a run-config env block.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stokr_platform
DB_USER=postgres
DB_PASSWORD=root
# If you only use `docker compose up postgres` (no local Postgres), use instead:
# DB_USER=stokr
# DB_PASSWORD=stokr

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Default OFF for local dev without RabbitMQ (no Connection refused / listener restart spam).
# Set both true when RabbitMQ is running (e.g. docker compose rabbitmq on localhost:5672).
STOKR_RABBIT_HEALTH_ENABLED=false
STOKR_RABBIT_LISTENERS_ENABLED=false
# Full stack example:
# STOKR_RABBIT_HEALTH_ENABLED=true
# STOKR_RABBIT_LISTENERS_ENABLED=true

# When true, API seeds sparse synthetic 1m candles for replay smoke tests (see stokr.replay.seed-synthetic-candles).
# docker-compose sets STOKR_REPLAY_SEED_SYNTHETIC=true by default for local stacks; use false in production and rely on real ingestion.
STOKR_REPLAY_SEED_SYNTHETIC=false

# If UI is not on 5173, set so the logged email-verification link matches your dev server:
# STOKR_EMAIL_VERIFY_BASE_URL=http://localhost:3000

# --- Zerodha + UI + CORS (one place; comma-separated lists, no spaces around commas optional) ---
STOKR_ZERODHA_API_KEY=your-zerodha-api-key
STOKR_ZERODHA_API_SECRET=your-zerodha-api-secret
# OAuth callback must match Kite app settings AND be reachable. Kite requires HTTPS — http://localhost is rejected by Zerodha.
# Use a tunnel (ngrok, Cloudflare Tunnel, etc.) to your API or deploy with TLS, e.g.:
# STOKR_ZERODHA_REDIRECT_URL=https://abc123.ngrok-free.app/api/broker/zerodha/callback
STOKR_ZERODHA_REDIRECT_URL=https://your-public-api-host/api/broker/zerodha/callback
# Where users land after OAuth (your UI origin). Use the same scheme/host users type (https, www vs apex) so the popup matches the opener tab.
STOKR_UI_PUBLIC_BASE_URL=http://localhost:5173
# ALL browser origins that may call the API (local dev ports + Docker UI :3000 + server IP/domain).
STOKR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Example server append (same variable — add your IP or domain to the line above on the server):
# ,http://13.206.226.81:3000
# Full server-style example:
# STOKR_ZERODHA_REDIRECT_URL=https://your-domain.example/api/broker/zerodha/callback
# STOKR_UI_PUBLIC_BASE_URL=http://13.206.226.81:3000
# STOKR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://13.206.226.81:3000

# SMTP for verification emails — Mailtrap (recommended dev): https://mailtrap.io/
# Inbox → Integrations → SMTP → copy credentials into repo-root .env (not committed).
SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=your-mailtrap-username
SPRING_MAIL_PASSWORD=your-mailtrap-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
# Optional: include mail in /actuator/health when credentials are set
# STOKR_MAIL_HEALTH_ENABLED=true
# Keep default false for local unless SMTP is fully configured. Server example:
# STOKR_MAIL_HEALTH_ENABLED=true
#
# Optional local Mailpit (alternative to Mailtrap): docker compose --profile tools up mailpit (UI :8025, SMTP :1025)

# Optional: throttle resend-verification (seconds between sends). 0 = off. Example production: 60
# STOKR_AUTH_VERIFY_RESEND_COOLDOWN=60

JWT_SECRET=replace-with-long-random-secret-min-256-bits-worth-for-production

# Strategy subscription default symbol when user toggles from catalog UI
STOKR_STRATEGY_SUBSCRIPTION_SYMBOL=NIFTY_FUT
# Max stock price (INR) for new signals; symbols above this are not emitted. 0 = no cap.
STOKR_STRATEGY_MAX_ENTRY_PRICE=5000

# Strategy runtime execution modes (LIVE | PAPER | DRY_RUN | DISABLED).
# Go-live cohort dispatches BOTH paper+live legs when strategy_execution_configs.execution_mode=BOTH.
STOKR_EXECUTION_MODES_ALLOW_LIVE=true
STOKR_EXECUTION_MODES_LIVE_VALIDATED=GAP_FILL,NSE_SPIKE_DETECTION,VWAP_BOUNCE,SECTOR_LAGGARD
STOKR_EXEC_MODE_GAP_FILL=LIVE
STOKR_EXEC_MODE_NSE_SPIKE=LIVE
STOKR_EXEC_MODE_VWAP_BOUNCE=LIVE
STOKR_EXEC_MODE_SECTOR_LAGGARD=LIVE
STOKR_EXEC_MODE_EARLY_BREAKOUT=PAPER
STOKR_EXEC_MODE_INDEX_HUNT=PAPER
STOKR_EXEC_MODE_ADV_CASH=PAPER
STOKR_EXEC_MODE_S3=PAPER
STOKR_EXEC_MODE_S7=PAPER

STOKR_LIVE_TRADING_ENABLED=true
STOKR_EXECUTION_LIVE_TRADING_ENABLED=true

# MCX evening session — extend OMS/risk windows (NSE still closes 15:30)
STOKR_OMS_MCX_NO_NEW_ENTRIES_AFTER=23:55
STOKR_OMS_MCX_FLATTEN_TIME=23:50
STOKR_OMS_MCX_FLATTEN_END=23:55
STOKR_RISK_TRADING_WINDOW_MCX_END=23:55
STOKR_MARKETDATA_SESSION_MCX_END=23:55

# MCX E2E test strategy (disable scan-fire when not testing)
STOKR_COMMODITIES_E2E_TEST_ENABLED=true
STOKR_COMMODITIES_E2E_TEST_SCAN_FIRE=false
STOKR_EXEC_MODE_COMMODITIES_E2E_TEST=PAPER

# Risk engine trading window — set END to 23:59 when running MCX (commodities trade until 23:30 IST).
# Default is 14:45 which is NSE-only cutoff. Override in .env (never commit the actual .env).
STOKR_RISK_TRADING_WINDOW_START=09:15
STOKR_RISK_TRADING_WINDOW_END=23:59

# When true, seeds synthetic OHLCV candles so mean-reversion (and similar) replays can run without tick ingestion.
# docker-compose sets STOKR_REPLAY_SEED_SYNTHETIC=true by default for local dev; use false in production.
# STOKR_REPLAY_SEED_SYNTHETIC=false

# --- Phase 0 production verification (manual; run on deployed HTTPS host) ---
# - stokr.in + www both serve UI; HTTP redirects to HTTPS at the edge.
# - STOKR_ZERODHA_REDIRECT_URL and STOKR_UI_PUBLIC_BASE_URL use https and match Kite + browser bar (apex vs www).
# - STOKR_CORS_ALLOWED_ORIGINS lists every UI origin (comma-separated).
# - Same-origin /ws from HTTPS uses WSS; nginx proxies /ws to the API container.
# - After EC2/Lightsail reboot: docker compose services reach healthy; RabbitMQ/Postgres reconnect.
# - Sample trade: set STOKR_ZERODHA_TEST_ORDER_ENABLED=true only when intentionally enabled.
