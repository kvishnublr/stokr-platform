# Copy to .env (optional) or export in shell — Spring Boot reads DB_* / JWT_* directly.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stokr_platform
DB_USER=postgres
DB_PASSWORD=root

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=replace-with-long-random-secret-min-256-bits-worth-for-production

# Strategy subscription default symbol when user toggles from catalog UI
STOKR_STRATEGY_SUBSCRIPTION_SYMBOL=NIFTY_FUT
