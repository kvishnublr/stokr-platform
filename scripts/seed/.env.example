# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Same value as STOKR_ZERODHA_API_KEY in your platform .env
ZERODHA_API_KEY=your_kite_api_key_here

# ── Platform field-cipher key ─────────────────────────────────────────────────
# Same value as STOKR_CRYPTO_FIELD_KEY in your platform .env
# The seeder uses this to decrypt the Zerodha access token stored in the DB.
# No manual token copying needed — the script reads it automatically.
STOKR_CRYPTO_FIELD_KEY=your_base64_encoded_32byte_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults
DB_URL=postgresql://stokr:stokr@localhost:5432/stokr_platform

# ── Seed config ───────────────────────────────────────────────────────────────
SEED_DAYS=60
CHUNK_DAYS=40
