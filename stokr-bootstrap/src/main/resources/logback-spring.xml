<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console: JSON in prod, human-readable otherwise -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
    </springProfile>
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Admin SSE ring-buffer appender (always on, threshold INFO) -->
    <appender name="SSE_LOG" class="com.stokr.admin.log.SseLogAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- Loki (only when loki profile active) -->
    <springProfile name="loki">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${LOKI_URL:-http://loki:3100}/loki/api/v1/push</url>
            </http>
            <format>
                <label>
                    <pattern>app=stokr,host=${HOSTNAME:-local},level=%level</pattern>
                </label>
                <message class="com.github.loki4j.logback.JsonLayout"/>
            </format>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SSE_LOG"/>
        <springProfile name="loki">
            <appender-ref ref="LOKI"/>
        </springProfile>
    </root>

    <!-- Reduce noise from framework internals -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.springframework.web.servlet.mvc.method.annotation.SseEmitter" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
</configuration>
