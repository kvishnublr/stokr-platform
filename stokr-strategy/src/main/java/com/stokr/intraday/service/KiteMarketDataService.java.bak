package com.stokr.intraday.service;

import com.zerodha.kiteconnect.KiteConnect;
import com.zerodha.kiteconnect.exceptions.KiteException;
import com.zerodha.kiteconnect.utils.Constants;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.math.BigDecimal;
import java.util.*;

/**
 * Kite API Market Data Service for INDEX HUNT
 * Fetches: NIFTY/BANKNIFTY prices, VIX, PCR, option premiums
 *
 * Requires: KITE_API_KEY, KITE_ACCESS_TOKEN in environment
 */
@Service
@Slf4j
public class KiteMarketDataService {

    private final KiteConnect kiteConnect;

    @Value("${kite.api.key:}")
    private String apiKey;

    @Value("${kite.access.token:}")
    private String accessToken;

    // Kite instrument tokens (permanent, never change)
    private static final int NIFTY_TOKEN = 256265;
    private static final int BANKNIFTY_TOKEN = 260105;
    private static final int INDIAVIX_TOKEN = 264969;

    // Option strike selection
    private static final int ATM_STEPS = 0;  // 0 = ATM, 1 = 1-step OTM

    public KiteMarketDataService(KiteConnect kiteConnect) {
        this.kiteConnect = kiteConnect;
    }

    /**
     * Get real-time quote for NIFTY or BANKNIFTY
     */
    public KiteQuote getIndexQuote(String indexName) {
        try {
            int token = "NIFTY".equalsIgnoreCase(indexName) ? NIFTY_TOKEN : BANKNIFTY_TOKEN;
            String instrumentKey = Constants.MODE_QUOTE;

            // Fetch quote from Kite
            Map<String, Object> quotes = kiteConnect.getQuotes(instrumentKey, String.valueOf(token));
            Map<String, Object> data = (Map<String, Object>) quotes.get("data");
            Map<String, Object> quote = (Map<String, Object>) data.get(String.valueOf(token));

            KiteQuote result = new KiteQuote();
            result.lastPrice = new BigDecimal(quote.get("last_price").toString());
            result.open = new BigDecimal(quote.get("open").toString());
            result.high = new BigDecimal(quote.get("high").toString());
            result.low = new BigDecimal(quote.get("low").toString());
            result.close = new BigDecimal(quote.get("close").toString());
            result.volume = Long.parseLong(quote.get("volume").toString());
            result.oi = Long.parseLong(quote.getOrDefault("oi", 0L).toString());
            result.timestamp = System.currentTimeMillis() / 1000;

            log.debug("KITE.quote_fetched index={} price={} volume={}", indexName, result.lastPrice, result.volume);
            return result;

        } catch (KiteException | IOException e) {
            log.error("KITE.quote_error index={} error={}", indexName, e.getMessage());
            return null;
        }
    }

    /**
     * Get VIX level (India VIX)
     */
    public BigDecimal getVIX() {
        try {
            KiteQuote vixQuote = getIndexQuote("INDIAVIX");
            if (vixQuote != null) {
                log.debug("KITE.vix_fetched level={}", vixQuote.lastPrice);
                return vixQuote.lastPrice;
            }
        } catch (Exception e) {
            log.error("KITE.vix_fetch_error {}", e.getMessage());
        }
        return BigDecimal.valueOf(16.0); // Default calm market
    }

    /**
     * Calculate PCR (Put-Call OI Ratio) from option chain
     *
     * PCR = Sum(Put OI) / Sum(Call OI)
     * - PCR > 1.0: Bearish (more puts bought)
     * - PCR < 1.0: Bullish (more calls bought)
     */
    public BigDecimal calculatePCR(String indexName) {
        try {
            int token = "NIFTY".equalsIgnoreCase(indexName) ? NIFTY_TOKEN : BANKNIFTY_TOKEN;

            // Fetch option chain (nearest expiry)
            Map<String, Object> chainData = kiteConnect.getOptionChain(
                    "NFO",  // Exchange
                    indexName,
                    "CE"    // Option type (will fetch both CE and PE)
            );

            long totalCallOI = 0;
            long totalPutOI = 0;

            List<Map<String, Object>> strikes = (List<Map<String, Object>>) chainData.get("data");

            for (Map<String, Object> strike : strikes) {
                Map<String, Object> ce = (Map<String, Object>) strike.get("call_options");
                Map<String, Object> pe = (Map<String, Object>) strike.get("put_options");

                if (ce != null && ce.containsKey("oi")) {
                    totalCallOI += Long.parseLong(ce.get("oi").toString());
                }
                if (pe != null && pe.containsKey("oi")) {
                    totalPutOI += Long.parseLong(pe.get("oi").toString());
                }
            }

            BigDecimal pcr = totalCallOI > 0 ?
                    BigDecimal.valueOf(totalPutOI).divide(BigDecimal.valueOf(totalCallOI), 4, java.math.RoundingMode.HALF_UP) :
                    BigDecimal.ONE;

            log.debug("KITE.pcr_calculated index={} pcr={} callOI={} putOI={}",
                    indexName, pcr, totalCallOI, totalPutOI);
            return pcr;

        } catch (KiteException | IOException e) {
            log.error("KITE.pcr_calculation_error index={} error={}", indexName, e.getMessage());
            return BigDecimal.ONE; // Default neutral
        }
    }

    /**
     * Get option premiums for ATM/OTM strikes
     *
     * Returns: CE and PE LTPs for liquid strikes
     */
    public OptionPremiums getOptionPremiums(String indexName, BigDecimal spotPrice) {
        try {
            int token = "NIFTY".equalsIgnoreCase(indexName) ? NIFTY_TOKEN : BANKNIFTY_TOKEN;

            // Calculate strike (ATM = spotPrice rounded)
            int strikeInterval = "NIFTY".equalsIgnoreCase(indexName) ? 50 : 100;
            int atmStrike = (spotPrice.intValue() / strikeInterval) * strikeInterval;

            // Fetch chain
            Map<String, Object> chainData = kiteConnect.getOptionChain("NFO", indexName, "CE");
            List<Map<String, Object>> strikes = (List<Map<String, Object>>) chainData.get("data");

            OptionPremiums premiums = new OptionPremiums();

            // Find ATM and OTM strikes
            for (Map<String, Object> strikeData : strikes) {
                int currentStrike = Integer.parseInt(strikeData.get("strike").toString());

                // Get CE premium
                if (currentStrike == atmStrike) {
                    Map<String, Object> ce = (Map<String, Object>) strikeData.get("call_options");
                    if (ce != null && ce.containsKey("last_price")) {
                        premiums.ceATM = new BigDecimal(ce.get("last_price").toString());
                    }
                }

                // Get PE premium
                if (currentStrike == atmStrike) {
                    Map<String, Object> pe = (Map<String, Object>) strikeData.get("put_options");
                    if (pe != null && pe.containsKey("last_price")) {
                        premiums.peATM = new BigDecimal(pe.get("last_price").toString());
                    }
                }
            }

            log.debug("KITE.option_premiums index={} strike={} ce={} pe={}",
                    indexName, atmStrike, premiums.ceATM, premiums.peATM);
            return premiums;

        } catch (KiteException | IOException e) {
            log.error("KITE.option_premium_error index={} error={}", indexName, e.getMessage());
            return new OptionPremiums();
        }
    }

    /**
     * Get 5-minute OHLC bars for price movement calculation
     */
    public List<KiteCandleData> get5MinBars(String indexName, int barCount) {
        try {
            int token = "NIFTY".equalsIgnoreCase(indexName) ? NIFTY_TOKEN : BANKNIFTY_TOKEN;
            String interval = "5minute";

            // Fetch historical data
            List<Object[]> candles = kiteConnect.getHistoricalData(
                    String.valueOf(token),
                    interval,
                    "1d",  // 1 day back
                    barCount
            );

            List<KiteCandleData> bars = new ArrayList<>();
            for (Object[] candle : candles) {
                KiteCandleData bar = new KiteCandleData();
                bar.timestamp = (Long) candle[0];
                bar.open = new BigDecimal(candle[1].toString());
                bar.high = new BigDecimal(candle[2].toString());
                bar.low = new BigDecimal(candle[3].toString());
                bar.close = new BigDecimal(candle[4].toString());
                bar.volume = (Long) candle[5];
                bars.add(bar);
            }

            log.debug("KITE.5min_bars_fetched index={} bars={}", indexName, bars.size());
            return bars;

        } catch (KiteException | IOException e) {
            log.error("KITE.5min_bars_error index={} error={}", indexName, e.getMessage());
            return new ArrayList<>();
        }
    }

    /**
     * Calculate 5-minute momentum (% change from 5 bars ago)
     */
    public BigDecimal calculate5minMomentum(String indexName) {
        List<KiteCandleData> bars = get5MinBars(indexName, 10);

        if (bars.size() < 2) {
            return BigDecimal.ZERO;
        }

        KiteCandleData currentBar = bars.get(bars.size() - 1);
        KiteCandleData previousBar = bars.size() >= 2 ? bars.get(bars.size() - 2) : bars.get(0);

        BigDecimal change = currentBar.close.subtract(previousBar.close)
                .divide(previousBar.close, 6, java.math.RoundingMode.HALF_UP)
                .multiply(BigDecimal.valueOf(100));

        log.debug("KITE.5min_momentum index={} momentum={}%", indexName, change);
        return change;
    }

    /**
     * Calculate 30-minute trend
     */
    public BigDecimal calculate30minTrend(String indexName) {
        // Get 30-min or 60-min bars (2-3 bars for 30m trend)
        try {
            // Using 5-min bars, get last 6 = 30 minutes
            List<KiteCandleData> bars = get5MinBars(indexName, 6);

            if (bars.size() < 2) {
                return BigDecimal.ZERO;
            }

            KiteCandleData current30mClose = bars.get(bars.size() - 1);
            KiteCandleData prev30mClose = bars.get(Math.max(0, bars.size() - 6));

            BigDecimal trend = current30mClose.close.subtract(prev30mClose.close)
                    .divide(prev30mClose.close, 6, java.math.RoundingMode.HALF_UP)
                    .multiply(BigDecimal.valueOf(100));

            log.debug("KITE.30min_trend index={} trend={}%", indexName, trend);
            return trend;

        } catch (Exception e) {
            log.error("KITE.30min_trend_error index={} error={}", indexName, e.getMessage());
            return BigDecimal.ZERO;
        }
    }

    /**
     * Get recent high/low for anti-chase filter
     */
    public Map<String, BigDecimal> getRecent3minExtremes(String indexName) {
        List<KiteCandleData> bars = get5MinBars(indexName, 3);

        Map<String, BigDecimal> extremes = new HashMap<>();

        BigDecimal high = BigDecimal.ZERO;
        BigDecimal low = null;

        for (KiteCandleData bar : bars) {
            if (bar.high.compareTo(high) > 0) {
                high = bar.high;
            }
            if (low == null || bar.low.compareTo(low) < 0) {
                low = bar.low;
            }
        }

        extremes.put("high", high);
        extremes.put("low", low != null ? low : BigDecimal.ZERO);

        log.debug("KITE.3min_extremes index={} high={} low={}", indexName, high, extremes.get("low"));
        return extremes;
    }

    // ===== DTOs =====

    public static class KiteQuote {
        public BigDecimal lastPrice;
        public BigDecimal open;
        public BigDecimal high;
        public BigDecimal low;
        public BigDecimal close;
        public Long volume;
        public Long oi;
        public Long timestamp;
    }

    public static class KiteCandleData {
        public Long timestamp;
        public BigDecimal open;
        public BigDecimal high;
        public BigDecimal low;
        public BigDecimal close;
        public Long volume;
    }

    public static class OptionPremiums {
        public BigDecimal ceATM = BigDecimal.ZERO;
        public BigDecimal peATM = BigDecimal.ZERO;
    }
}
