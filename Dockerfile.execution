# Execution Service Dockerfile
# Builds and runs the V3 execution worker as an independently deployable service.

FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

COPY pom.xml .
COPY stokr-common/pom.xml stokr-common/
COPY stokr-auth/pom.xml stokr-auth/
COPY stokr-user/pom.xml stokr-user/
COPY stokr-broker/pom.xml stokr-broker/
COPY stokr-oms/pom.xml stokr-oms/
COPY stokr-risk/pom.xml stokr-risk/
COPY stokr-marketdata/pom.xml stokr-marketdata/
COPY stokr-strategy/pom.xml stokr-strategy/
COPY stokr-execution/pom.xml stokr-execution/

RUN mvn -q dependency:go-offline -pl stokr-execution -am -DskipTests

COPY stokr-common stokr-common
COPY stokr-auth stokr-auth
COPY stokr-user stokr-user
COPY stokr-broker stokr-broker
COPY stokr-oms stokr-oms
COPY stokr-risk stokr-risk
COPY stokr-marketdata stokr-marketdata
COPY stokr-strategy stokr-strategy
COPY stokr-execution stokr-execution

RUN mvn package -pl stokr-execution -am -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S stokr && adduser -S stokr -G stokr

COPY --from=builder /build/stokr-execution/target/stokr-execution-*-exec.jar /app/stokr-execution.jar

USER stokr
EXPOSE 8082
ENV JAVA_OPTS="-Xms512m -Xmx1024m -Dstokr.strategy.publisher.enabled=false"
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8082/actuator/health || exit 1

CMD exec java $JAVA_OPTS -jar /app/stokr-execution.jar
