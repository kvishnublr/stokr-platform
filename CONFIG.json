{
  "environments": {
    "staging": {
      "api": {
        "baseURL": "http://173.249.55.84:8080/api",
        "timeout": 5000,
        "retries": 3,
        "retryDelay": 1000
      },
      "features": {
        "enableMetrics": true,
        "enableLogging": true,
        "enableErrorReporting": true,
        "enableAnalytics": true
      },
      "security": {
        "enableSSL": false,
        "enableAuth": true,
        "tokenExpiry": 3600,
        "corsAllowed": ["https://new.stokr.in", "http://localhost:3000"]
      },
      "database": {
        "host": "173.249.55.84",
        "port": 5432,
        "pool_size": 20,
        "timeout": 30000
      }
    },
    "production": {
      "api": {
        "baseURL": "https://api.stokr.in/v1",
        "timeout": 5000,
        "retries": 3,
        "retryDelay": 1000
      },
      "features": {
        "enableMetrics": true,
        "enableLogging": true,
        "enableErrorReporting": true,
        "enableAnalytics": true
      },
      "security": {
        "enableSSL": true,
        "enableAuth": true,
        "tokenExpiry": 3600,
        "corsAllowed": ["https://stokr.in", "https://new.stokr.in"]
      },
      "database": {
        "host": "prod-db.stokr.in",
        "port": 5432,
        "pool_size": 50,
        "timeout": 30000
      }
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": ["console", "file"],
    "fileRotation": "daily",
    "retention": 30
  },
  "monitoring": {
    "enableHealthCheck": true,
    "healthCheckInterval": 30000,
    "enablePerformanceTracking": true,
    "enableErrorTracking": true
  },
  "deployment": {
    "version": "1.0.0",
    "buildDate": "2024-01-15",
    "releaseNotes": "Initial Nature Organic design implementation with full Trader and Admin panels",
    "requiredServices": [
      "api-server",
      "database",
      "cache",
      "broker-gateway"
    ],
    "healthCheckEndpoints": [
      "/health",
      "/api/health",
      "/status"
    ]
  }
}
