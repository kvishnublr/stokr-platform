# Strategy Service Dockerfile
# Builds and runs the independent Strategy Service microservice

FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

# Copy only pom files first (cache layer)
COPY pom.xml .
COPY stokr-common/pom.xml stokr-common/
COPY stokr-strategy/pom.xml stokr-strategy/

# Install dependencies (cached if pom.xml doesn't change)
RUN mvn dependency:resolve -DskipTests 2>/dev/null || true

# Copy source code
COPY stokr-common stokr-common
COPY stokr-strategy stokr-strategy

# Build only strategy service
RUN mvn clean package -pl stokr-strategy -am -DskipTests \
    && ls -la stokr-strategy/target/*.jar

# Runtime stage
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Copy built jar from builder
COPY --from=builder /build/stokr-strategy/target/stokr-strategy-*.jar app.jar

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8081/actuator/health || exit 1

# Run service
EXPOSE 8081
ENV JAVA_OPTS="-Xmx1024m -Xms512m"
CMD exec java $JAVA_OPTS -jar app.jar
