stokr.in, www.stokr.in {
    encode gzip zstd

    # Cache busting for assets
    @assets {
        path /assets/*
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # No cache for HTML and JS
    header /*.html Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    header /*.js Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    header /index.html Cache-Control "no-cache, no-store, must-revalidate, max-age=0"

    # API routes (must come BEFORE UI routes to prevent capture)
    reverse_proxy /api/* stokr-api:8080

    # Webhooks
    reverse_proxy /webhooks/chartink* localhost:8081

    # UI routes (comes after API routes)
    reverse_proxy /signals* localhost:8082
    reverse_proxy /signals/index.html localhost:8082
    reverse_proxy /backtest* localhost:8082
    reverse_proxy /backtest/index.html localhost:8082

    # All other UI routes go to stokr-lite-frontend (port 8082 UI)
    reverse_proxy stokr-lite-frontend:80
}

new.stokr.in {
    encode gzip zstd
    reverse_proxy stokr-ui:80
}
